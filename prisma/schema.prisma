// datasource and generator setup
datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

// ---------------------------------------------------------
//  ENUMS
// ---------------------------------------------------------

enum UserStatus {
    ACTIVE
    BLOCK
}

enum Role {
    SUPER_ADMIN
    ADMIN
    USER
}

enum TaskStatus {
    ALL_TASK
    ONGOING
    PENDING
    IN_PROGRESS
    COLLABORATIVE_TASK
    DONE
}

enum TaskCategory {
    ARTS_AND_CRAFT
    NATURE
    FAMILY
    SPORT
    FRIENDS
    MEDITATION
}

// ---------------------------------------------------------
//  MODELS
// ---------------------------------------------------------

model User {
    id           String     @id @default(auto()) @map("_id") @db.ObjectId
    fullName     String
    email        String     @unique
    password     String
    profileImage String?    @default("https://i.ibb.co.com/XfLzVy23/download.png")
    userStatus   UserStatus @default(ACTIVE)
    otp          String?
    otpExpiry    DateTime?
    hexCode      String?
    role         Role       @default(USER)
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    @@map("users")
}

model Task {
    id          String       @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    status      TaskStatus   @default(PENDING)
    category    TaskCategory @default(ARTS_AND_CRAFT)
    date        DateTime
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    @@map("tasks")
}
